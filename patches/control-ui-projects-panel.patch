 }
+/* ─── Project Management panel (inbox-first sidebar view) ─────────────── */
+.sidebar-projects-toggle--active {
+  background: var(--surface-2, rgba(0, 0, 0, 0.06));
+  color: var(--accent, inherit);
+}
+
+.pm-panel {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 10px 6px;
+  overflow-y: auto;
+  min-height: 0;
+  flex: 1;
+}
+
+/* The custom element host must also be a bounded flex child of the sidebar
+   body, or its inner .pm-panel can't grow and scroll. */
+openclaw-projects-panel {
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  min-height: 0;
+}
+
+.pm-panel__heading {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 2px 6px 10px;
+  font-weight: 600;
+  font-size: 13px;
+  flex-shrink: 0;
+  border-bottom: 1px solid var(--border, rgba(128, 128, 128, 0.22));
+}
+.pm-panel__icon {
+  display: inline-flex;
+  color: var(--muted);
+}
+.pm-panel__title {
+  white-space: nowrap;
+}
+
+/* ---- sections (Inbox / Projects) ---- */
+.pm-section {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+.pm-section__head {
+  display: flex;
+  align-items: baseline;
+  gap: 6px;
+  padding: 6px 6px 2px;
+  font-size: 11px;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  color: var(--muted);
+}
+.pm-section__label {
+  font-weight: 600;
+}
+.pm-section__hint {
+  font-size: 10px;
+  text-transform: none;
+  letter-spacing: 0;
+  color: var(--muted);
+  opacity: 0.8;
+}
+/* + button on the Projects section header (right-aligned) */
+.pm-add--head {
+  margin-left: auto;
+}
+.pm-section__body {
+  display: flex;
+  flex-direction: column;
+}
+/* divider under the Inbox section body */
+.pm-section--divider .pm-section__body {
+  padding-bottom: 10px;
+  border-bottom: 1px solid var(--border, rgba(128, 128, 128, 0.22));
+}
+
+/* + add buttons */
+.pm-add {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 18px;
+  height: 18px;
+  padding: 0;
+  border: none;
+  border-radius: var(--radius-s, 4px);
+  background: none;
+  color: var(--muted);
+  cursor: pointer;
+  flex-shrink: 0;
+  opacity: 0.75;
+}
+.pm-add:hover {
+  opacity: 1;
+  color: var(--text, inherit);
+  background: var(--surface-2, rgba(0, 0, 0, 0.06));
+}
+.pm-add svg {
+  width: 14px;
+  height: 14px;
+  stroke: currentColor;
+  fill: none;
+  stroke-width: 2px;
+}
+.pm-add--project {
+  margin-left: 2px;
+}
+
+/* ---- inbox rows (name + project tag) ---- */
+.pm-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 5px 8px;
+  border-radius: var(--radius-s, 6px);
+  cursor: pointer;
+  font-size: 12.5px;
+  line-height: 1.35;
+}
+.pm-row:hover {
+  background: var(--surface-2, rgba(0, 0, 0, 0.06));
+}
+.pm-row__name {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  flex: 1 1 auto;
+  min-width: 0;
+}
+.pm-row--project {
+  gap: 6px;
+  padding: 4px 8px 4px 10px;
+}
+.pm-row__time {
+  font-size: 10px;
+  color: var(--muted);
+  opacity: 0.85;
+  flex-shrink: 0;
+  font-variant-numeric: tabular-nums;
+}
+
+/* project tag next to an inbox row's name */
+.pm-project-tag {
+  flex-shrink: 0;
+  font-size: 10px;
+  color: var(--muted);
+  background: var(--surface-2, rgba(0, 0, 0, 0.06));
+  border-radius: var(--radius-full, 999px);
+  padding: 1px 7px;
+  max-width: 90px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* state dot */
+.pm-dot {
+  display: inline-block;
+  flex-shrink: 0;
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  margin-left: 1px;
+}
+.pm-dot--active { background: var(--accent, #4c9aff); }
+.pm-dot--deferred { background: #eab308; }
+.pm-dot--done { background: var(--success, #16a34a); }
+
+/* grouped state dots shown in a collapsed project header (per-state breakdown) */
+.pm-dots {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  flex-shrink: 0;
+  margin-left: auto;
+}
+.pm-dotitem {
+  display: inline-flex;
+  align-items: center;
+  gap: 3px;
+  line-height: 1;
+}
+.pm-dotitem .pm-dot {
+  margin-left: 0;
+}
+.pm-dotitem__n {
+  font-size: 10px;
+  color: var(--muted);
+  font-variant-numeric: tabular-nums;
+}
+
+/* noinbox marker */
+.pm-noinbox {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  color: var(--muted);
+  opacity: 0.7;
+}
+.pm-noinbox svg {
+  width: 12px;
+  height: 12px;
+  stroke: currentColor;
+  fill: none;
+  stroke-width: 1.7px;
+}
+
+/* ---- projects ---- */
+.pm-project {
+  display: flex;
+  flex-direction: column;
+}.pm-project__head {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 4px 6px;
+  border-radius: var(--radius-s, 6px);
+  cursor: pointer;
+  user-select: none;
+  font-size: 12.5px;
+}
+.pm-project__head:hover {
+  background: var(--surface-2, rgba(0, 0, 0, 0.06));
+}
+.pm-project__name {
+  flex: 1 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-weight: 500;
+}
+.pm-project__count {
+  flex-shrink: 0;
+  font-size: 10px;
+  color: var(--muted);
+  background: var(--surface-2, rgba(0, 0, 0, 0.06));
+  border-radius: var(--radius-full, 999px);
+  min-width: 18px;
+  height: 18px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 0 5px;
+}
+/* state dot shown only when the project is collapsed */
+.pm-project__head .pm-dot {
+  margin-left: 2px;
+}
+.pm-chevron {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--muted);
+  flex-shrink: 0;
+  opacity: 0.8;
+}
+.pm-chevron svg {
+  width: 12px;
+  height: 12px;
+  stroke: currentColor;
+  fill: none;
+  stroke-width: 1.7px;
+}
+
+/* per-project session filter (active/deferred/done + count) */
+.pm-project__filter {
+  display: flex;
+  gap: 4px;
+  padding: 2px 8px 2px 22px;
+  flex-wrap: wrap;
+}
+.pm-filter {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  font-size: 10px;
+  line-height: 1;
+  padding: 3px 8px;
+  border-radius: var(--radius-full, 999px);
+  border: 1px solid var(--border, rgba(128, 128, 128, 0.25));
+  background: none;
+  color: var(--muted);
+  cursor: pointer;
+  text-transform: capitalize;
+}
+.pm-filter:hover {
+  border-color: currentColor;
+}
+.pm-filter--on {
+  background: var(--surface-2, rgba(0, 0, 0, 0.08));
+  border-color: currentColor;
+}
+.pm-filter--on.pm-filter--active { color: var(--accent, inherit); }
+.pm-filter--on.pm-filter--deferred { color: #eab308; }
+.pm-filter--on.pm-filter--done { color: var(--success, #16a34a); }
+.pm-filter__n {
+  font-size: 9px;
+  opacity: 0.85;
+  font-variant-numeric: tabular-nums;
+}
+.pm-project__body {
+  display: flex;
+  flex-direction: column;
+  padding-left: 6px;
+}
+
+.pm-empty {
+  padding: 6px 8px 6px 22px;
+  color: var(--muted);
+  font-size: 12px;
+  font-style: italic;
+}
+
+/* ------------------------------------------------------------------ */
+/* PM project-state tabs (view projects by their own state)           */
+/* Independent of the per-session filter inside each folder.          */
+/* ------------------------------------------------------------------ */
+.pm-project-tabs {
+  display: flex;
+  gap: 4px;
+  padding: 0 4px 8px;
+}
+.pm-project-tab {
+  flex: 1;
+  font-size: 11px;
+  line-height: 1;
+  padding: 5px 6px;
+  border-radius: 6px;
+  border: 1px solid var(--border, rgba(128, 128, 128, 0.25));
+  background: none;
+  color: var(--muted);
+  cursor: pointer;
+  text-transform: capitalize;
+  white-space: nowrap;
+}
+.pm-project-tab:hover {
+  border-color: currentColor;
+}
+.pm-project-tab--on {
+  background: var(--surface-2, rgba(0, 0, 0, 0.08));
+  color: var(--text, inherit);
+  border-color: currentColor;
+  font-weight: 600;
+}
