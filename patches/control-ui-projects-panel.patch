index 0000000..13b8870
--- /dev/null
+++ b/ui/src/components/projects-panel.ts
@@ -0,0 +1,394 @@
+// Project Management panel — REAL DATA (Track 2 wiring).
+//
+// This is the dumb UI prototype (Track 1) with the hardcoded DUMMY_* dataset
+// replaced by real reads from the projects plugin:
+//   GET /plugins/projects/api  →  { ok, state, agents, sessions }
+//
+// The rendering logic is unchanged from the validated dumb UI. Only the data
+// source changed. Writes (createProject/createThread/setSessionState/
+// setNoInbox/setProjectState) POST to the same route then reload.
+//
+// Auth: the panel is rendered inside app-sidebar, which passes the gateway
+// device token via the `authToken` property (from
+// context.gateway.snapshot.hello.auth.deviceToken). Same-origin fetch with
+// `Authorization: Bearer <token>` + `credentials: "same-origin"`.
+
+import { LitElement, html, nothing } from "lit";
+import { property, state } from "lit/decorators.js";
+import { icons } from "./icons.ts";
+
+type LifecycleState = "active" | "deferred" | "done";
+
+// ---------------------------------------------------------------------------
+// Real data shapes (from GET /plugins/projects/api)
+// ---------------------------------------------------------------------------
+type ApiAgent = {
+  id: string;
+  name?: string;
+  emoji?: string;
+};
+
+type ApiSession = {
+  key: string;
+  name?: string;
+  label?: string;
+  agentId?: string; // parsed from key by the plugin
+  updatedAt?: number;
+  [k: string]: unknown;
+};
+
+type ApiState = {
+  version?: number;
+  projects: Record<string, { state?: LifecycleState }>;
+  sessions: Record<string, { state?: LifecycleState; noInbox?: boolean }>;
+};
+
+type ApiResponse = {
+  ok: boolean;
+  state?: ApiState;
+  agents?: ApiAgent[];
+  sessions?: ApiSession[];
+  error?: string;
+};
+
+// ---------------------------------------------------------------------------
+// Component
+// ---------------------------------------------------------------------------
+export class ProjectsPanel extends LitElement {
+  override createRenderRoot() {
+    return this;
+  }
+
+  @property({ attribute: false }) collapsed = false;
+  @property({ attribute: false }) onOpenSession?: (sessionKey: string) => void;
+  @property({ attribute: false }) authToken?: string | null;
+
+  @state() private collapsedProjects = new Set<string>();
+  @state() private sessionFilters = new Map<string, LifecycleState>(); // per-project session filter (independent per folder)
+  @state() private projectFilter: LifecycleState | "all" = "all"; // across-project filter
+
+  // ---- data source (real) ----
+  @state() private agents: ApiAgent[] = [];
+  @state() private sessions: ApiSession[] = [];
+  @state() private stateStore: ApiState = { projects: {}, sessions: {} };
+  @state() private loading = true;
+  @state() private error: string | null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    void this.load();
+  }
+
+  private async load() {
+    this.loading = true;
+    this.error = null;
+    try {
+      const headers = new Headers({ Accept: "application/json" });
+      const token = this.authToken?.trim();
+      if (token) headers.set("Authorization", `Bearer ${token}`);
+      const res = await fetch("/plugins/projects/api", {
+        method: "GET",
+        headers,
+        credentials: "same-origin",
+      });
+      if (!res.ok) {
+        this.error = `API ${res.status}`;
+        return;
+      }
+      const data = (await res.json()) as ApiResponse;
+      if (!data.ok) {
+        this.error = data.error ?? "API error";
+        return;
+      }
+      this.agents = data.agents ?? [];
+      this.sessions = data.sessions ?? [];
+      this.stateStore = data.state ?? { projects: {}, sessions: {} };
+    } catch (err) {
+      this.error = String(err);
+    } finally {
+      this.loading = false;
+    }
+  }
+
+  private async post(op: Record<string, unknown>) {
+    try {
+      const headers = new Headers({ "Content-Type": "application/json" });
+      const token = this.authToken?.trim();
+      if (token) headers.set("Authorization", `Bearer ${token}`);
+      const res = await fetch("/plugins/projects/api", {
+        method: "POST",
+        headers,
+        credentials: "same-origin",
+        body: JSON.stringify(op),
+      });
+      if (!res.ok) {
+        this.error = `POST ${res.status}`;
+        return;
+      }
+      const data = (await res.json()) as { ok: boolean; error?: string };
+      if (!data.ok) {
+        this.error = data.error ?? "POST error";
+        return;
+      }
+      await this.load();
+    } catch (err) {
+      this.error = String(err);
+    }
+  }
+
+  // ---- derived helpers ----
+  private projectState(agentId: string): LifecycleState {
+    return this.stateStore.projects[agentId]?.state ?? "active";
+  }
+
+  private sessionState(key: string): LifecycleState {
+    return this.stateStore.sessions[key]?.state ?? "active";
+  }
+
+  private sessionNoInbox(key: string): boolean {
+    return this.stateStore.sessions[key]?.noInbox ?? false;
+  }
+
+  private projectName(agent: ApiAgent): string {
+    return agent.name || agent.id;
+  }
+
+  private updatedHoursAgo(s: ApiSession): number {
+    const t = s.updatedAt;
+    if (typeof t !== "number" || !Number.isFinite(t)) return Infinity;
+    return (Date.now() - t) / 3_600_000;
+  }
+
+  // ---- inbox: active + within 2 days + not noInbox'd ----
+  private inboxSessions(): ApiSession[] {
+    return this.sessions
+      .filter(
+        (s) =>
+          this.sessionState(s.key) === "active" &&
+          !this.sessionNoInbox(s.key) &&
+          this.updatedHoursAgo(s) <= 48,
+      )
+      .sort((a, b) => this.updatedHoursAgo(a) - this.updatedHoursAgo(b));
+  }
+
+  // ---- projects, filtered by their own (independent) state ----
+  private filteredProjects(): ApiAgent[] {
+    const all = this.agents;
+    if (this.projectFilter === "all") return all;
+    return all.filter((a) => this.projectState(a.id) === this.projectFilter);
+  }
+
+  // ---- per-project session filter (independent across folders) ----
+  private sessionFilterFor(projectId: string): LifecycleState {
+    return this.sessionFilters.get(projectId) ?? "active";
+  }
+  private setSessionFilterFor(projectId: string, st: LifecycleState) {
+    const next = new Map(this.sessionFilters);
+    next.set(projectId, st);
+    this.sessionFilters = next;
+  }
+
+  private toggleProject(id: string) {
+    const next = new Set(this.collapsedProjects);
+    if (next.has(id)) next.delete(id);
+    else next.add(id);
+    this.collapsedProjects = next;
+  }
+
+  private renderStateDot(state: LifecycleState) {
+    return html`<span class="pm-dot pm-dot--${state}" title=${state}></span>`;
+  }
+
+  private renderProjectTag(projectName: string) {
+    return html`<span class="pm-project-tag">${projectName}</span>`;
+  }
+
+  private renderInboxRow(s: ApiSession) {
+    const name = s.name || s.label || s.key;
+    const agent = this.agents.find((a) => a.id === s.agentId);
+    return html`
+      <div
+        class="pm-row"
+        data-key=${s.key}
+        @click=${() => this.onOpenSession?.(s.key)}
+      >
+        <span class="pm-row__name">${name}</span>
+        ${agent ? this.renderProjectTag(this.projectName(agent)) : nothing}
+      </div>
+    `;
+  }
+
+  private renderProjectStateDots(members: ApiSession[]) {
+    // Per-state breakdown: one colored dot + count per session state present.
+    return html`<span class="pm-dots">
+      ${(["active", "deferred", "done"] as LifecycleState[]).map((st) => {
+        const n = members.filter((m) => this.sessionState(m.key) === st).length;
+        return n > 0
+          ? html`<span class="pm-dotitem">
+              <span class="pm-dot pm-dot--${st}"></span><span class="pm-dotitem__n">${n}</span>
+            </span>`
+          : nothing;
+      })}
+    </span>`;
+  }
+
+  private renderProjectRow(s: ApiSession) {
+    const name = s.name || s.label || s.key;
+    const hours = this.updatedHoursAgo(s);
+    const time = hours === Infinity ? "—" : hours < 1 ? "now" : hours < 24 ? `${Math.round(hours)}h` : `${Math.round(hours / 24)}d`;
+    return html`
+      <div
+        class="pm-row pm-row--project"
+        data-key=${s.key}
+        @click=${() => this.onOpenSession?.(s.key)}
+      >
+        ${this.renderStateDot(this.sessionState(s.key))}
+        <span class="pm-row__name">${name}</span>
+        ${this.sessionNoInbox(s.key) ? html`<span class="pm-noinbox" title="Hidden from inbox">${icons.eyeOff}</span>` : nothing}
+        <span class="pm-row__time">${time}</span>
+      </div>
+    `;
+  }
+
+  private addProject() {
+    const name = window.prompt("New project name");
+    if (!name?.trim()) return;
+    void this.post({ op: "createProject", name: name.trim() });
+  }
+
+  private addSession(projectId: string) {
+    const label = window.prompt(`New session in ${projectId}`);
+    if (!label?.trim()) return;
+    void this.post({ op: "createThread", agentId: projectId, label: label.trim() });
+  }
+
+  override render() {
+    const inbox = this.inboxSessions();
+    const filteredProjects = this.filteredProjects();
+
+    return html`
+      <div class="pm-panel ${this.collapsed ? "pm-panel--collapsed" : ""}">
+        <div class="pm-panel__heading">
+          <span class="pm-panel__icon" aria-hidden="true">${icons.kanban}</span>
+          <span class="pm-panel__title">Project Management</span>
+        </div>
+
+        ${this.loading
+          ? html`<div class="pm-empty">Loading…</div>`
+          : this.error
+            ? html`<div class="pm-empty pm-empty--error">${this.error}</div>`
+            : html`
+        <!-- INBOX -->
+        <div class="pm-section pm-section--divider">
+          <div class="pm-section__head">
+            <span class="pm-section__label">Inbox</span>
+            <span class="pm-section__hint">active · last 2 days</span>
+          </div>
+          <div class="pm-section__body pm-inbox">
+            ${inbox.length === 0
+              ? html`<div class="pm-empty">Nothing active in the last 2 days.</div>`
+              : inbox.map((s) => this.renderInboxRow(s))}
+          </div>
+        </div>
+
+        <!-- PROJECTS -->
+        <div class="pm-section">
+          <div class="pm-section__head">
+            <span class="pm-section__label">Projects</span>
+            <button
+              class="pm-add pm-add--head"
+              type="button"
+              title="New project"
+              @click=${(e: Event) => {
+                e.stopPropagation();
+                this.addProject();
+              }}
+            >
+              ${icons.plus}
+            </button>
+          </div>
+
+          <!-- PROJECT STATE TABS: view projects by their own state (independent of session state) -->
+          <div class="pm-project-tabs">
+            ${(["all", "active", "deferred", "done"] as const).map((f) => {
+              const on = this.projectFilter === f;
+              return html`
+                <button
+                  class="pm-project-tab ${on ? "pm-project-tab--on" : ""}"
+                  @click=${(e: Event) => {
+                    e.stopPropagation();
+                    this.projectFilter = f;
+                  }}
+                >
+                  ${f}
+                </button>
+              `;
+            })}
+          </div>
+
+          ${filteredProjects.map((p) => {
+            const members = this.sessions.filter((s) => s.agentId === p.id);
+            const collapsed = this.collapsedProjects.has(p.id);
+            const projectSessionFilter = this.sessionFilterFor(p.id);
+            const filtered = members.filter((s) => this.sessionState(s.key) === projectSessionFilter);
+            return html`
+              <div class="pm-project">
+                <div class="pm-project__head" @click=${() => this.toggleProject(p.id)}>
+                  <span class="pm-chevron" aria-hidden="true"
+                    >${collapsed ? icons.chevronRight : icons.chevronDown}</span
+                  >
+                  <span class="pm-project__name">${this.projectName(p)}</span>
+                  ${collapsed ? this.renderProjectStateDots(members) : nothing}
+                  <span class="pm-project__count">${members.length}</span>
+                  <button
+                    class="pm-add pm-add--project"
+                    type="button"
+                    title="New session in ${this.projectName(p)}"
+                    @click=${(e: Event) => {
+                      e.stopPropagation();
+                      this.addSession(p.id);
+                    }}
+                  >
+                    ${icons.plus}
+                  </button>
+                </div>
+
+                ${collapsed
+                  ? nothing
+                  : html`
+                      <div class="pm-project__filter">
+                        ${(["active", "deferred", "done"] as LifecycleState[]).map((st) => {
+                          const n = members.filter((m) => this.sessionState(m.key) === st).length;
+                          return html`
+                            <button
+                              class="pm-filter ${projectSessionFilter === st ? "pm-filter--on" : ""}"
+                              @click=${(e: Event) => {
+                                e.stopPropagation();
+                                this.setSessionFilterFor(p.id, st);
+                              }}
+                            >
+                              ${st} ${n > 0 ? html`<span class="pm-filter__n">${n}</span>` : nothing}
+                            </button>
+                          `;
+                        })}
+                      </div>
+
+                      <div class="pm-project__body">
+                        ${filtered.length === 0
+                          ? html`<div class="pm-empty">No ${projectSessionFilter} sessions.</div>`
+                          : filtered.map((s) => this.renderProjectRow(s))}
+                      </div>
+                    `}
+              </div>
+            `;
+          })}
+        </div>
+        `}
+      </div>
+    `;
+  }
+}
+
+if (!customElements.get("openclaw-projects-panel")) {
+  customElements.define("openclaw-projects-panel", ProjectsPanel);
+}
