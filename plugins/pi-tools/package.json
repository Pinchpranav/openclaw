{
  "name": "@pranav/pi-tools",
  "version": "0.1.0",
  "description": "Lean pi_ toolset (pi_read, pi_bash, pi_edit, pi_write) — pi-feeling file/shell tools as an OpenClaw plugin.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "dependencies": {
    "@openclaw/plugin-sdk": "file:/opt/openclaw/app/packages/plugin-sdk",
    "@silvia-odwyer/photon-node": "0.3.4",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.6.3"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1"
    }
  }
}